# Supabase project settings
# URL: dashboard -> Connect (or Settings -> Data API)
# Key: Settings -> API Keys -> Secret keys (sb_secret_...). Legacy service_role key also works.
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Port for local development. Render sets PORT automatically in production.
PORT=3000

# Set to "production" on Render.
NODE_ENV=development

# Set to "false" to hide the leaderboard.
LEADERBOARD_ENABLED=true

# Optional: set to "true" to run WITHOUT Supabase using a temporary in-memory store.
# Data is lost when the server restarts. Never use this in production.
USE_MEMORY_STORE=false
